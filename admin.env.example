# Keep the admin page local when using an SSH tunnel.
ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional multi-user hashed credentials, created by `hw add-user`.
# ADMIN_USERS_FILE=/etc/stockwatch-users.json

# For a reverse proxy, add its exact hostname to ADMIN_ALLOWED_HOSTS and set a
# strong password. The browser will show a Basic Auth prompt.
