# Keep the admin page local when using an SSH tunnel.
ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Fresh installs create admin with a random password, displayed once in the
# installer terminal. Existing credentials are kept; recover with `hw passwd`.
# Multi-user hashed credentials, created by the installer or `hw add-user`.
# ADMIN_USERS_FILE=/etc/stockwatch-users.json

# For a reverse proxy, run `hw admin-domain watch.example.com` to allow the
# exact hostname and initialize missing credentials. The browser prompts for login.
