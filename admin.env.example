# The native admin server listens publicly on TCP 25678. Restrict this port in
# the firewall or put an HTTPS reverse proxy in front of it.
# All proxy domains are accepted; ADMIN_ALLOWED_HOSTS is no longer used.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_HOST=0.0.0.0
ADMIN_PORT=25678
ADMIN_ALLOW_REMOTE=1

# Fresh installs create admin with a random password, displayed once in the
# installer terminal. Existing credentials are kept; recover with `hw passwd`.
# Multi-user hashed credentials, created by the installer or `hw add-user`.
# ADMIN_USERS_FILE=/etc/stockwatch-users.json

# Reverse proxy to http://127.0.0.1:25678 and sign in with your admin account.
# For older installations without credentials, first run `hw init-admin`.
