[Unit]
Description=HostWatch egress proxy agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hostwatch-egress
WorkingDirectory=/opt/hostwatch-egress
EnvironmentFile=/etc/hostwatch-egress.env
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 /opt/hostwatch-egress/egress_agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
