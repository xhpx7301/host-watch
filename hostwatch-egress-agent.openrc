#!/sbin/openrc-run
description="HostWatch egress proxy agent"
command="/usr/bin/python3"
command_args="/opt/hostwatch-egress/egress_agent.py"
command_user="hostwatch-egress:hostwatch-egress"
directory="/opt/hostwatch-egress"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/hostwatch-egress.log"
error_log="/var/log/hostwatch-egress.log"
export EGRESS_CONFIG="/etc/hostwatch-egress.json"

depend() {
  need net
  after firewall
}
